{
  "name": "travel",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "start": "next start",
    "lint": "eslint",
    "seed": "tsx --env-file=.env.local scripts/seed.ts",
    "seed:wipe": "tsx --env-file=.env.local scripts/seed.ts --wipe",
    "seed:auth": "tsx --env-file=.env.local scripts/seed-auth.ts",
    "seed:avatars": "tsx --env-file=.env.local scripts/seed-avatars.ts",
    "db:migrate": "drizzle-kit migrate",
    "db:generate": "drizzle-kit generate",
    "check:media": "tsx --env-file=.env.local scripts/check-media.ts",
    "sweep:media": "NODE_OPTIONS=--conditions=react-server tsx --env-file=.env.local scripts/sweep-media.ts",
    "storage:migrate": "tsx --env-file=.env.local scripts/migrate-storage.ts",
    "storage:fixkeys": "tsx --env-file=.env.local scripts/fix-media-keys.ts",
    "photo": "tsx --env-file=.env.local scripts/photo-preview.ts"
  },
  "dependencies": {
    "@auth/drizzle-adapter": "^1.11.3",
    "@tiptap/extension-image": "^3.31.3",
    "@tiptap/extension-link": "^3.31.3",
    "@tiptap/extension-placeholder": "^3.31.3",
    "@tiptap/pm": "^3.31.3",
    "@tiptap/react": "^3.31.3",
    "@tiptap/starter-kit": "^3.31.3",
    "drizzle-orm": "^0.45.3",
    "next": "16.3.7",
    "next-auth": "^5.0.0-beta.32",
    "nodemailer": "^8.0.11",
    "postgres": "^3.4.9",
    "react": "19.2.8",
    "react-dom": "19.2.8",
    "server-only": "^0.0.1",
    "zod": "^4.6.5"
  },
  "devDependencies": {
    "@tailwindcss/postcss": "^4",
    "@types/node": "^20",
    "@types/nodemailer": "^8.0.2",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "dotenv": "^18.0.4",
    "drizzle-kit": "^0.31.11",
    "eslint": "^9",
    "eslint-config-next": "16.3.7",
    "tailwindcss": "^4",
    "tsx": "^4.23.15",
    "typescript": "^5"
  }
}
